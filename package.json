{
  "name": "rsh-research",
  "version": "0.2.0",
  "description": "A lightweight, local, Git-native research state notebook for agents.",
  "type": "module",
  "bin": {
    "rsh": "bin/rsh.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenty2333/rsh.git"
  },
  "homepage": "https://github.com/chenty2333/rsh#readme",
  "bugs": {
    "url": "https://github.com/chenty2333/rsh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check bin/rsh.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check && npm test",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "research",
    "git",
    "mcp",
    "markdown",
    "ripgrep",
    "research-state"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "smol-toml": "^1.8.0",
    "zod": "^3.25.76"
  }
}
