{
  "name": "rsh-research",
  "version": "0.1.0",
  "description": "Private-first, Git-native compiler and static analyzer for persistent research state.",
  "type": "module",
  "bin": {
    "rsh": "./bin/rsh.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenty2333/rsh.git"
  },
  "homepage": "https://github.com/chenty2333/rsh#readme",
  "bugs": {
    "url": "https://github.com/chenty2333/rsh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check bin/rsh.js && find src -name '*.js' -print0 | xargs -0 -n1 node --check && npm test",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "research",
    "git",
    "mcp",
    "mathematics",
    "static-analysis",
    "knowledge-graph"
  ],
  "license": "MIT"
}
