{
  "name": "rsh-research",
  "version": "0.1.5",
  "description": "A lightweight, bounded memory layer for long-running agent work.",
  "type": "module",
  "bin": {
    "rsh": "bin/rsh.js"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    ".codex-plugin/",
    "hooks/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenty2333/rsh.git"
  },
  "homepage": "https://github.com/chenty2333/rsh#readme",
  "bugs": {
    "url": "https://github.com/chenty2333/rsh/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check bin/rsh.js && find src hooks -type f \\( -name '*.js' -o -name '*.mjs' \\) -print0 | xargs -0 -n1 node --check && npm test",
    "pack:dry": "npm pack --dry-run"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "agents",
    "context",
    "memory",
    "mcp",
    "codex",
    "long-running-tasks"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "smol-toml": "^1.8.0",
    "zod": "^3.25.76"
  }
}
